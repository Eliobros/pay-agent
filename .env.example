[TEMPLATE]
# --- AI model (any OpenAI-compatible API) ---
MODEL_API_KEY=your_model_api_key
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_NAME=muse-spark-1.3

# --- PayPal (create a REST app in Sandbox at developer.paypal.com) ---
# Fallback credentials. Once the owner saves PayPal credentials in the
# dashboard (Payment providers), those encrypted values take precedence.
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook id from the PayPal REST app (Webhooks → the webhook you created for
# https://YOUR-HOST/webhooks/paypal). Without it no notification is accepted.
PAYPAL_WEBHOOK_ID=

# --- App ---
# Exact address where you open the web app, no trailing slash.
# This is where PayPal sends the buyer back (/success and /cancel).
FRONTEND_ORIGIN=http://localhost:3000
# Comma-separated origins allowed to call the API with credentials (cookies).
# Defaults to FRONTEND_ORIGIN. Add a second address here (www, a preview
# deployment, a second store) instead of changing FRONTEND_ORIGIN.
FRONTEND_ORIGINS=
STORE_NAME=Demo Store
DEFAULT_STORE_ID=store_demo
PRODUCTS_FILE=products.json
DB_PATH=payagent.db
EVIDENCE_DIR=evidence
EVIDENCE_STORAGE=local

# --- Owner authentication ---
# First owner is created through the /owner page. Leave registration closed
# afterwards unless you want more accounts.
ALLOW_OWNER_REGISTRATION=false
# Optional shared code, required when registration is open
OWNER_SIGNUP_CODE=
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false
# Leave empty to pick the safe default: `none` when the frontend is HTTPS
# (the dashboard on another domain, e.g. Vercel, needs it), `lax` otherwise.
# With `lax` a cross-site browser would keep the cookie but never send it,
# and the owner would look logged out on every request.
SESSION_COOKIE_SAMESITE=
LOGIN_RATE_LIMIT_PER_MIN=8

# --- Secret encryption (AES-256-GCM master key) ---
# Generate one with:
#   python -c "from payagent.security import generate_key; print(generate_key())"
# Keep it outside the database and never commit it.
CREDENTIAL_ENCRYPTION_KEY=

# --- Safety rules ---
MAX_ORDER_USD=200
MAX_AUTO_REFUND_USD=100
RATE_LIMIT_PER_MIN=20
MAX_HISTORY=30
CONVERSATION_TTL_HOURS=24
MAX_EVIDENCE_MB=15
MAX_VIDEO_SECONDS=60
# Evidence of closed refund requests is deleted after this many days
EVIDENCE_RETENTION_DAYS=30
